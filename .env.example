# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (e.g. website@techventics.com).
# Until techventics.com is verified, use: Techventics <onboarding@resend.dev>
# (that test sender only delivers to the Resend account owner's own email).
CONTACT_FROM_EMAIL="Techventics Website <onboarding@resend.dev>"

# Where enquiries are delivered
CONTACT_TO_EMAIL=Info@techventics.com

# Public site URL, used for sitemap, canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=https://techventics.com
