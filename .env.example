# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Contact form ─────────────────────────────────────────────
# Where enquiries are delivered
CONTACT_TO_EMAIL=Info@techventics.com

# Option 1 (recommended with cPanel hosting): send through your own mailbox over SMTP.
# In cPanel → Email Accounts → (mailbox) → Connect Devices, copy the "Outgoing Server" details.
# Typically: host mail.techventics.com, port 465 (SSL). Use the full email address as the user.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option 2: Resend (used only if SMTP_* is empty). https://resend.com/api-keys
RESEND_API_KEY=

# Optional sender override. With SMTP it defaults to the SMTP_USER mailbox;
# with Resend it must be on a domain verified in Resend.
# CONTACT_FROM_EMAIL="Techventics Website <website@techventics.com>"

# ── Site ─────────────────────────────────────────────────────
# Public site URL, used for sitemap, canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=https://techventics.com
