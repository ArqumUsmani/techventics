# Copy to .env.local. Never commit .env.local.

# Public site URL, baked into the static build for canonical URLs, sitemap,
# robots.txt and share images. Set it before running `npm run build` for the live site.
NEXT_PUBLIC_SITE_URL=https://techventics.com

# The contact form needs no secrets: on the live site it posts to public/contact.php,
# which emails Info@techventics.com through cPanel's mail server. Change the addresses
# at the top of that file.
